[Unit]
Description=Omarchy tablet mode bottom touch bar
PartOf=graphical-session.target
After=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/omarchy-tablet-mode/settings
ExecStart=/usr/bin/qs --no-duplicate --path %h/.local/share/omarchy-tablet-mode/ui
ExecStopPost=%h/.local/share/omarchy-tablet-mode/bin/tablet-mode restore-dock
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
